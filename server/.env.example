# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. On a deployed host, set these as the
# platform's environment variables instead of using a file at all.

# Base URL of the deployed frontend — used to build links in verification/
# password-reset emails (e.g. https://myapp.example.com). Defaults to the
# local Vite dev server.
APP_BASE_URL=http://localhost:5173

# Port the Express server itself listens on.
PORT=3001

# Set to "production" on a real deploy — affects cookie security flags.
NODE_ENV=development

# Cookie SameSite policy. "lax" works when the client and API share an
# origin (the default single-service deploy, or Vite's dev proxy). If you
# split the client and API onto different origins, set this to "none" and
# make sure the API runs over HTTPS (browsers require Secure for
# SameSite=None cookies).
COOKIE_SAMESITE=lax

# SMTP email provider (Phase 8) — any SMTP-compatible service works here;
# nothing about the provider is hardcoded. Used for email verification,
# 2FA login codes, and password reset links. Leave unset in local dev to
# have emails logged to the console instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
MAIL_FROM=

# DeepSeek (optional — can also be set from the app's own Settings window).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
