# In local dev, leave this unset — Vite proxies /api to http://localhost:3001
# (see vite.config.js) so the server doesn't need to be publicly reachable.
#
# For a production build served from a different origin than the API
# (e.g. client on Vercel, API on Render/Railway), set this to the deployed
# API's full base URL, including the /api suffix:
# VITE_API_BASE=https://your-api.onrender.com/api
